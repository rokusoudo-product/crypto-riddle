{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rokusoudo-product.github.io/crypto-riddle/schemas/scenario.schema.json",
  "title": "crypto-riddle Scenario",
  "description": "1マップ(=1インシデント事件)を表現するシナリオデータのスキーマ。spec.md §4〜§8 の「導入/探索/解決」3パート構成に対応する。\n\n位置づけ(重要): 本スキーマは Issue #3 の受け入れ基準を満たすための暫定バリデーション定義であり、plan.md §1/§4 が定める『zod スキーマが正、YAML は入力形式』の方針において、リポジトリに TypeScript 実装(T005: src/core/model/ の zod スキーマ)が用意されるまでの橋渡し役を担う。T005 着手後は、zod スキーマがこのファイルを置き換えるか、zod-to-json-schema 等で本ファイルを自動生成する形に一本化すること。手動でのフィールド追従が必要な間、正本は常に本ファイルではなく spec.md/plan.md の決定である。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "subject_tags",
    "difficulty",
    "estimated_minutes",
    "source",
    "intro",
    "investigation_points",
    "cards",
    "resolution"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "本スキーマのバージョン(semver)。破壊的変更時にインクリメントする。",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "description": "マップID。ファイル名(拡張子除く)と一致させる。",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "description": "マップタイトル(事件名)。",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "制作ステータス。省略時は draft 扱い。",
      "enum": ["draft", "reviewed", "published", "sample"],
      "default": "draft"
    },
    "map_order": {
      "type": "integer",
      "description": "進行順(spec §9 の難易度カーブ用)。任意。未設定はマップ選択順不定を意味する。",
      "minimum": 1
    },
    "subject_tags": {
      "type": "array",
      "description": "分野タグ(spec §9)。複数可。",
      "items": { "$ref": "#/$defs/subjectTag" },
      "minItems": 1,
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "description": "難易度(1=最も易しい 〜 5=最も難しい)。spec §9 の S1-2/S3-6/S7-8 の目安に沿って設定する。",
      "minimum": 1,
      "maximum": 5
    },
    "estimated_minutes": {
      "type": "integer",
      "description": "想定プレイ時間(分)。spec US-1 の『10〜15分』が目安。",
      "minimum": 1,
      "maximum": 60
    },
    "source": { "$ref": "#/$defs/source" },
    "related_terms": {
      "type": "array",
      "description": "用語カードマスタ(Issue #4)への緩い参照。用語ID配列のみを持ち、用語マスタ側の具体的ファイル形式には依存しない(#4 未マージのため疎結合とする)。",
      "items": { "$ref": "#/$defs/termId" },
      "uniqueItems": true
    },
    "intro": { "$ref": "#/$defs/intro" },
    "investigation_points": {
      "type": "array",
      "description": "探索パートの調査ポイント(人物/PC/ログ/物証)。spec §7 の3系統(ログを見る/人に聞く/文献を引く)で分類する。",
      "items": { "$ref": "#/$defs/investigationPoint" },
      "minItems": 1
    },
    "cards": {
      "type": "array",
      "description": "獲得しうるヒントカード全体(正解カード・ダミーカードを含む)。対策カードもここに含む(spec §7 のカード種別)。",
      "items": { "$ref": "#/$defs/card" },
      "minItems": 1
    },
    "resolution": { "$ref": "#/$defs/resolution" }
  },
  "$defs": {
    "subjectTag": {
      "type": "string",
      "description": "spec.md §9 で定義された分野タグ(この6種で固定)。",
      "enum": ["暗号", "認証", "Web", "攻撃手法", "インシデント対応", "法制度"]
    },
    "cardType": {
      "type": "string",
      "description": "spec §7 / DESIGN.md で定義されたカード種別(この7種で固定)。",
      "enum": ["証言", "ログ", "通信記録", "外部情報", "暗号文", "鍵", "対策"]
    },
    "investigationCategory": {
      "type": "string",
      "description": "spec §7 の調査3系統。",
      "enum": ["ログを見る", "人に聞く", "文献を引く"]
    },
    "character": {
      "type": "string",
      "description": "サポート役キャラの短縮表記。霧島=霧島悠(技術)、橘=橘澪(法務)。docs/characters.md が正本。",
      "enum": ["霧島", "橘"]
    },
    "termId": {
      "type": "string",
      "description": "用語カードマスタ(Issue #4)側のID。パターンのみを規定し、実ファイルの存在は本スキーマでは検証しない。",
      "pattern": "^term-[a-z0-9_-]+$"
    },
    "legalRefId": {
      "type": "string",
      "description": "legal/*.yaml 内の法制度データID(LAW- prefix)。実在確認は scripts/validate_scenarios.py が行う。",
      "pattern": "^LAW-[A-Z0-9_-]+$"
    },
    "source": {
      "type": "object",
      "description": "出典表記。IPA過去問由来か創作かを明示する(spec FR-7)。#14(出典表記規則)が確定するまでは type/free-note の緩い構造とする。",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ipa_sc_am2", "ipa_sc_pm", "original", "other"],
          "description": "ipa_sc_am2=SC午前II、ipa_sc_pm=SC午後、original=完全創作、other=その他(note必須)。"
        },
        "exam_period": {
          "type": "string",
          "description": "例: '2025年 秋期'。type が ipa_sc_* の場合に指定する。"
        },
        "question_no": {
          "type": "string",
          "description": "例: '問17'。type が ipa_sc_* の場合に指定する。"
        },
        "note": {
          "type": "string",
          "description": "自由記述。改変の有無・他出典との合成等を記す。#14 確定後にフォーマットを見直す。"
        }
      }
    },
    "dialogueLine": {
      "type": "object",
      "description": "サポート役キャラの台詞1行。",
      "additionalProperties": false,
      "required": ["character", "line"],
      "properties": {
        "character": { "$ref": "#/$defs/character" },
        "line": { "type": "string", "minLength": 1 }
      }
    },
    "intro": {
      "type": "object",
      "description": "導入パート(spec §4.1)。",
      "additionalProperties": false,
      "required": ["background", "victim_company", "character_intros"],
      "properties": {
        "background": {
          "type": "string",
          "description": "事件発生の背景テキスト。",
          "minLength": 1
        },
        "victim_company": {
          "type": "object",
          "description": "被害会社設定(架空企業。実在企業・実在事案を特定できない描写にする / docs/characters.md §9)。",
          "additionalProperties": false,
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "industry": { "type": "string" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "character_intros": {
          "type": "array",
          "description": "サポート役の導入台詞(事件概要と目的の説明)。",
          "items": { "$ref": "#/$defs/dialogueLine" },
          "minItems": 1
        }
      }
    },
    "investigationPoint": {
      "type": "object",
      "description": "探索パートの調査ポイント1件。",
      "additionalProperties": false,
      "required": ["id", "category", "label", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "category": { "$ref": "#/$defs/investigationCategory" },
        "label": {
          "type": "string",
          "description": "調査対象の短い名前(例: '経理部PCのログ')。",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "調査時に表示する説明文。",
          "minLength": 1
        }
      }
    },
    "card": {
      "type": "object",
      "description": "ヒントカード1件。investigation_point_id で獲得元の調査ポイントに紐づく。",
      "additionalProperties": false,
      "required": ["id", "type", "source", "investigation_point_id", "body", "is_dummy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "type": { "$ref": "#/$defs/cardType" },
        "source": {
          "type": "string",
          "description": "カードの物語上の出所(証言者名・機器名等)。",
          "minLength": 1
        },
        "investigation_point_id": {
          "type": "string",
          "description": "獲得元の investigation_points[].id。",
          "pattern": "^[a-z0-9_-]+$"
        },
        "body": {
          "type": "string",
          "description": "カード本文(証言内容・ログ抜粋等)。",
          "minLength": 1
        },
        "is_dummy": {
          "type": "boolean",
          "description": "true=もっともらしいが直接原因ではないダミーカード(spec §7)。"
        },
        "related_terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/termId" },
          "uniqueItems": true
        }
      }
    },
    "cipherStage": {
      "type": "object",
      "description": "暗号解読ミニゲーム1段分。MVP は1種のみ(#3 代表回答)。将来の複数段拡張は cipher_stages 配列の要素追加で対応する想定。",
      "additionalProperties": false,
      "required": ["id", "method", "ciphertext", "key", "key_hint", "plaintext"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "method": {
          "type": "string",
          "description": "暗号方式。MVP はシーザー暗号(caesar)を基本とする。新方式追加時はここに文字列を追加する(enum化しない=拡張余地を残す/#3 代表回答)。",
          "minLength": 1,
          "examples": ["caesar", "base64", "xor", "hash_match"]
        },
        "ciphertext": {
          "type": "string",
          "description": "解読対象の暗号文。",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "description": "正解の鍵(例: シーザー暗号ならシフト数を文字列で)。plan §4 の方針により正解は当面平文で保持する。",
          "minLength": 1
        },
        "key_hint": {
          "type": "string",
          "description": "鍵を推理させるためのヒント文(答えそのものは書かない)。",
          "minLength": 1
        },
        "plaintext": {
          "type": "string",
          "description": "復号後の正解平文。判定時は core/judge の正規化(NFKC・大小文字・カナ変換・空白除去)後に厳密一致させる(plan §3)。",
          "minLength": 1
        },
        "card_ref": {
          "type": "string",
          "description": "暗号文を提供するカードの id(任意)。",
          "pattern": "^[a-z0-9_-]+$"
        }
      }
    },
    "attackIdentification": {
      "type": "object",
      "description": "攻撃手段の特定(spec §8.2)。MVP は単一解・厳密一致(#7 決定、部分点・複数正解ルートなし)。",
      "additionalProperties": false,
      "required": ["required_card_ids", "attack_name", "attack_description"],
      "properties": {
        "required_card_ids": {
          "type": "array",
          "description": "正解の組合せに必要なカードID(cards[].id を参照)。ダミーカード(is_dummy=true)を含めてはならない。",
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "attack_name": {
          "type": "string",
          "description": "特定される攻撃手段の名称(例: 'パスワードリスト攻撃')。",
          "minLength": 1
        },
        "attack_description": {
          "type": "string",
          "description": "攻撃手段の解説(クリア後解説にも利用)。",
          "minLength": 1
        }
      }
    },
    "countermeasure": {
      "type": "object",
      "description": "防衛策の選択(spec §8.3)。type='対策' のカードから正解カードを選ぶ。",
      "additionalProperties": false,
      "required": ["required_card_ids", "summary"],
      "properties": {
        "required_card_ids": {
          "type": "array",
          "description": "有効な対策として選ぶべきカードID(cards[].id のうち type='対策' かつ is_dummy=false のもの)。",
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "description": "防衛策の要点。",
          "minLength": 1
        }
      }
    },
    "followUp": {
      "type": "object",
      "description": "誤答時のサポート役フォロー台詞(spec §5: 答えは言わない/考え方の提示に留める)。",
      "additionalProperties": false,
      "required": ["trigger", "character", "line"],
      "properties": {
        "trigger": {
          "type": "string",
          "enum": ["cipher", "attack_identification", "countermeasure"]
        },
        "character": { "$ref": "#/$defs/character" },
        "line": { "type": "string", "minLength": 1 }
      }
    },
    "resolution": {
      "type": "object",
      "description": "解決パート(spec §8): 暗号解読→攻撃特定→防衛策選択。",
      "additionalProperties": false,
      "required": [
        "cipher_stages",
        "attack_identification",
        "countermeasure",
        "wrong_answer_follow_ups",
        "clear_explanation"
      ],
      "properties": {
        "cipher_stages": {
          "type": "array",
          "description": "暗号解読ミニゲームの段数。MVP は必ず1要素(#3 代表回答)。0要素(暗号なしマップ)は将来のマップ種別拡張まで許容しない。",
          "items": { "$ref": "#/$defs/cipherStage" },
          "minItems": 1,
          "maxItems": 1
        },
        "attack_identification": { "$ref": "#/$defs/attackIdentification" },
        "countermeasure": { "$ref": "#/$defs/countermeasure" },
        "wrong_answer_follow_ups": {
          "type": "array",
          "items": { "$ref": "#/$defs/followUp" },
          "minItems": 1
        },
        "clear_explanation": {
          "type": "array",
          "description": "クリア後解説(サポート役2名の台詞。spec §5 の役割④)。",
          "items": { "$ref": "#/$defs/dialogueLine" },
          "minItems": 1
        },
        "legal_refs": {
          "type": "array",
          "description": "このマップで参照する法制度データ(legal/*.yaml)のID。任意(法制度が関わらないマップでは省略可)。",
          "items": { "$ref": "#/$defs/legalRefId" },
          "uniqueItems": true
        }
      }
    }
  }
}
