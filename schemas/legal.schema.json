{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rokusoudo-product.github.io/crypto-riddle/schemas/legal.schema.json",
  "title": "crypto-riddle Legal Reference Data",
  "description": "条文番号・報告期限等、改正で変わりうる法制度データのスキーマ(plan.md §4: シナリオ本体から分離し更新可能なデータとして持つ)。シナリオ側は legal_refs でこのファイルの id を参照するのみで、条文番号・期限の文言をシナリオ本体に直接埋め込まない(docs/characters.md §9)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "laws"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "0.1.0"
    },
    "laws": {
      "type": "array",
      "items": { "$ref": "#/$defs/lawEntry" },
      "minItems": 1
    }
  },
  "$defs": {
    "lawEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "law_name",
        "article",
        "title",
        "report_deadline",
        "summary",
        "last_verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "シナリオ側から legal_refs で参照するID。",
          "pattern": "^LAW-[A-Z0-9_-]+$"
        },
        "law_name": {
          "type": "string",
          "description": "法令名(例: 個人情報の保護に関する法律)。",
          "minLength": 1
        },
        "article": {
          "type": "string",
          "description": "条文番号(例: '22条の2')。改正で変わりうるため必ずこのフィールドに分離する。",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "description": "条文の見出し(例: 漏えい等の報告等)。",
          "minLength": 1
        },
        "report_deadline": {
          "type": "string",
          "description": "報告期限の要約(例: '速報:知った日から概ね3〜5日以内/確報:30日以内(不正目的等は60日以内)')。改正で変わりうるためここに分離する。",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "description": "学習用の平易な要約。",
          "minLength": 1
        },
        "last_verified": {
          "type": "string",
          "description": "この記載内容を確認した日付(YYYY-MM-DD)。改正追従の目安に使う。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_url": {
          "type": "string",
          "description": "根拠となる公的情報源のURL(任意)。",
          "format": "uri"
        }
      }
    }
  }
}
